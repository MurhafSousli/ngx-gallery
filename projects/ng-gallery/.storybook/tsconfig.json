{
  "extends": "../tsconfig.lib.json",
  "compilerOptions": {
    "jsx": "react",
    "types": [
      "node"
    ],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "../src/test.ts",
    "../src/lib/tests/*.ts",
    "../src/**/*.spec.ts"
  ],
  "include": [
    "../src/**/*.stories.*",
    "../src/**/*.ts",
    "./.storybook/*.ts"
  ],
  "files": [
    "./typings.d.ts"
  ]
}
