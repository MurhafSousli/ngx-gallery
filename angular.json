{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ng-gallery-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ng-gallery-demo",
      "sourceRoot": "projects/ng-gallery-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ng-gallery-demo/src/main.ts",
            "tsConfig": "projects/ng-gallery-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ng-gallery-demo/public"
              }
            ],
            "styles": [
              "projects/ng-gallery-demo/src/tailwind.css",
              "projects/ng-gallery-demo/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects"
              ]
            },
            "server": "projects/ng-gallery-demo/src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "projects/ng-gallery-demo/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ng-gallery-demo:build:production"
            },
            "development": {
              "buildTarget": "ng-gallery-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "ng-gallery": {
      "projectType": "library",
      "root": "projects/ng-gallery",
      "sourceRoot": "projects/ng-gallery",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-gallery/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-gallery/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-gallery/tsconfig.spec.json",
            "browsers": [
              "ChromiumHeadless"
            ],
            "coverage": true,
            "coverageExclude": [
              "projects/ng-gallery/src/lib/tests/**"
            ],
            "coverageReporters": [
              "text",
              "json",
              "html",
              "cobertura"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "styles": [
              "projects/ng-gallery/.storybook/styles.scss",
              "projects/ng-gallery/glass-theme.css"
            ],
            "configDir": "projects/ng-gallery/.storybook",
            "browserTarget": "ng-gallery:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/ng-gallery",
              "--disablePrivate",
              "--disableProtected",
              "--disableInternal",
              "--minimal"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "styles": [
              "projects/ng-gallery/.storybook/styles.scss",
              "projects/ng-gallery/glass-theme.css"
            ],
            "configDir": "projects/ng-gallery/.storybook",
            "browserTarget": "ng-gallery:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/ng-gallery",
              "--disablePrivate",
              "--disableProtected",
              "--disableInternal",
              "--minimal"
            ],
            "outputDir": "dist/storybook/ng-gallery"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-gallery/**/*.ts",
              "projects/ng-gallery/**/*.html"
            ],
            "eslintConfig": "projects/ng-gallery/eslint.config.js"
          }
        }
      }
    }
  }
}
