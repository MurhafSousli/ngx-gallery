{
  "name": "ng-gallery-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ng-gallery-demo --ssr=false --prerender=false",
    "build-ssr": "ng build ng-gallery-demo",
    "build-lib": "ng build ng-gallery",
    "postbuild-lib": "node scripts/copy-readme.mjs",
    "storybook-serve": "ng run ng-gallery:storybook --host",
    "storybook-build": "ng run ng-gallery:build-storybook",
    "watch": "ng build --watch --configuration development",
    "lint-lib": "ng lint ng-gallery",
    "test-lib": "ng test ng-gallery --browsers=chromium",
    "test-lib-headless": "ng test ng-gallery --no-watch",
    "serve:ssr:ng-gallery-demo": "node dist/ng-gallery-demo/server/server.mjs",
    "test-versions-handler": "node scripts/simulate-docs.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "ngx-highlightjs": "^14.0.1",
    "ngx-progressbar": "^14.0.0",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/angular-vite": "^10.5.9",
    "@storybook/icons": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-storybook": "^10.5.9",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^3.0.0",
    "ng-packagr": "^22.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "projects/ng-gallery/src"
    ]
  }
}
